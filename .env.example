# ─── Database ───────────────────────────────────────────────────────────────
# Get this from Supabase / Neon / Railway
# Example: postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"

# ─── Redis ──────────────────────────────────────────────────────────────────
# Get this from Upstash (free tier works great)
# Example: redis://default:xxxx@us1-xxxx.upstash.io:6379
REDIS_URL="redis://default:PASSWORD@HOST:PORT"

# ─── App URL ─────────────────────────────────────────────────────────────────
# Used for internal API calls during SSR
# Local dev: http://localhost:3000
# Production: https://your-app.vercel.app
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# ─── Cron Secret ─────────────────────────────────────────────────────────────
# Optional: protects /api/cron/release-expired from public access
# Set the same value in Vercel dashboard
CRON_SECRET="your-random-secret-here"
